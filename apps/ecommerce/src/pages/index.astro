    </div>
  </section>

  <!-- Catalog Section -->
  <section class="section-wrap" id="catalogo">
    <div class="section-header">
      <span class="sub-badge">Menú Comercial Exclusivo</span>
      <h2>Nuestras 10 Variantes Destacadas</h2>
