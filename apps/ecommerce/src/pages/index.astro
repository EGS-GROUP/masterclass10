        Desde nuestras insignias especiales ("Rey de las Burgers", "Burger Doble Especial") hasta nuestras recetas clásicas y dobles smash de alta cocina urbana.
      </p>
    </div>

    <!-- Category Filter Bar -->
    <div class="filter-bar">
      <button class="filter-btn active" data-filter="all">Todas las Variantes (10)</button>
      <button class="filter-btn" data-filter="especiales">Especiales de Autor (5)</button>
      <button class="filter-btn" data-filter="clasicas">Clásicas & Smash (3)</button>
      <button class="filter-btn" data-filter="dobles">Dobles Carne (1)</button>
      <button class="filter-btn" data-filter="pollo-veggie">Pollo & Veggie (2)</button>
    </div>

    <!-- Burger Cards Grid -->
    <div class="burger-grid">
      {burgers.map((burger) => (
        <article class="burger-card" data-category={burger.category}>
          <div class="burger-image-wrap">
            <span class="specialty-badge-pill">
              {burger.specialty_badge}
            </span>
            <img src={burger.image} alt={burger.name} class="burger-image" loading="lazy" />
            <span class="prep-tag">⏱️ {burger.prepTime}</span>
          </div>

          <div class="burger-body">
            <div class="burger-meta">
              <span class="burger-category">{burger.categoryLabel} &bull; {burger.specialty_level}</span>
              <span class="burger-calories">{burger.calories}</span>
            </div>

            <h3 class="burger-title">{burger.name}</h3>
            <p class="burger-description">{burger.description}</p>

            <div class="burger-footer">
              <div class="burger-price-wrap">
                <span class="price-label">Precio Especial</span>
                <span class="price-val">${burger.price.toFixed(2)}</span>
              </div>

              <div class="burger-actions">
                <button
                  type="button"
                  class="btn-detail open-modal-btn"
                  data-name={burger.name}
                  data-badge={burger.specialty_badge}
                  data-level={burger.specialty_level}
                  data-price={burger.price.toFixed(2)}
                  data-image={burger.image}
                  data-desc={burger.description}
                  data-ingredients={burger.ingredients}
                  data-time={burger.prepTime}
                  data-calories={burger.calories}
                  data-pairing={burger.pairing}
                >
                  Ver Detalles
                </button>
                <a href="/app" class="btn-order-fast" title="Simular compra en la app móvil">
                  <span>Pedir 📱</span>
                </a>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Interactive Detail Modal -->
  <div id="detail-modal" class="modal-overlay" role="dialog" aria-modal="true" aria-hidden="true">
    <div class="modal-card">
      <button id="close-modal-btn" class="modal-close-btn" aria-label="Cerrar modal">&times;</button>
      <img id="modal-img" src="" alt="Hamburguesa Detalle" class="modal-header-img" />
      <div class="modal-content-body">
        <span id="modal-badge" class="modal-badge">👑 Especialidad</span>
        <h3 id="modal-title" class="modal-title">Nombre de la Hamburguesa</h3>
        
        <div class="modal-price-row">
          <div class="modal-price" id="modal-price">$0.00</div>
          <div class="modal-spec" id="modal-time">⏱️ 8-10 min de preparación</div>
          <div class="modal-spec" id="modal-calories">🔥 850 kcal</div>
        </div>

        <p id="modal-desc" style="color: #94a3b8; font-size: 0.95rem; line-height: 1.6; margin-bottom: 1.5rem;"></p>

        <div class="modal-section-title">🌾 Ingredientes & Preparación Artesanal</div>
        <div id="modal-ingredients" class="modal-ingredients"></div>

        <div class="modal-section-title">🍷 Maridaje Recomendado por el Chef</div>
        <div id="modal-pairing" class="modal-pairing"></div>

        <div class="modal-footer-btns">
          <a href="/app" class="btn-modal-order">
            <span>🚀 Simular Compra en PWA Mobile</span>
          </a>
          <button id="modal-cancel-btn" class="btn-modal-close">Cerrar</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Why Rapid House Section -->
  <section class="section-wrap" id="secreto" style="padding-top: 1rem;">
    <div class="banner-secret">
      <div>
        <span style="color: #38bdf8; font-weight: 700; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.1em; display: block; margin-bottom: 0.5rem;">El Secreto de la Casa</span>
        <h3>Obsesionados con el Sabor y la Velocidad</h3>
        <p>
          En <strong>Hamburger Rapid</strong> transformamos el concepto de comida rápida tradicional. Combinamos técnica de asado al carbón y smash con cortes premium Black Angus, salsas de autor reducidas a fuego lento y entregas en menos de 20 minutos.
        </p>
        <a href="/app" class="btn-hero-primary" style="display: inline-flex;">
          <span>📲 Ordenar Ahora en la PWA</span>
        </a>
      </div>

      <div class="banner-points">
        <div class="point-card">
          <strong>🥩 Maduración Óptima</strong>
          <span>Cortes seleccionados con infiltración de grasa perfecta para smash jugoso.</span>
        </div>
        <div class="point-card">
          <strong>🍞 Brioche Francés</strong>
          <span>Masa madre, fermentación de 18 horas y tostado a la mantequilla francesa.</span>
        </div>
        <div class="point-card">
          <strong>🍯 Salsas Exclusivas</strong>
          <span>Salsa King al Bourbon, Honey Mustard Dijon y Alioli negro de autor.</span>
        </div>
        <div class="point-card">
          <strong>⏱️ Cocción al Segundo</strong>
          <span>Cronómetros de plancha de alta precisión para costra crujiente perfecta.</span>
        </div>
      </div>
    </div>

    <!-- PWA Simulation Promo Callout -->
    <div class="pwa-promo-box">
      <div style="font-size: 3rem; margin-bottom: 0.5rem;">📲</div>
      <h3>¿Listo para probar la experiencia móvil?</h3>
      <p>
        Prueba nuestra aplicación móvil PWA con pestañas inferiores de Menú interactivo, Cupones de Oferta exclusivos, Carrito con simulación de pedido en vivo y Perfil de cliente.
      </p>
      <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
        <a href="/app" class="btn-hero-primary">
          <span>Abrir PWA Mobile (/app)</span>
        </a>
        <a href="/admin" class="btn-hero-secondary">
          <span>Ver Dashboard Administrativo (/admin)</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer>
    <div class="footer-inner">
      <div class="brand-wrap">
        <span class="brand-logo-icon">🍔</span>
        <div class="brand-text">
          <div style="font-size: 1.15rem; font-weight: 800; color: white;">Hamburger Rapid</div>
          <span style="font-size: 0.72rem; color: #94a3b8;">La Primera Versión Comercial de Comida Rápida Inteligente</span>
        </div>
      </div>

      <div class="footer-links">
        <a href="/">E-commerce</a>
        <a href="/app">PWA Móvil</a>
        <a href="/admin">Panel Admin</a>
        <a href="/api/health">Estado API</a>
        <a href="/api/products">API Hamburguesas</a>
      </div>

      <div class="footer-copy">
        &copy; 2026 Hamburger Rapid &bull; Astro + React PWA + Node.js MySQL &bull; Dokploy CI/CD
      </div>
    </div>
  </footer>

  <!-- Client-side Interactive Script for Filters and Details Modal -->
  <script is:inline>
    // Category Filtering
    const filterButtons = document.querySelectorAll('.filter-btn');
    const burgerCards = document.querySelectorAll('.burger-card');

    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        filterButtons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        const filter = btn.getAttribute('data-filter');

        burgerCards.forEach(card => {
          const category = card.getAttribute('data-category');
          if (filter === 'all' || category === filter) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });

    // Modal Interaction
    const modal = document.getElementById('detail-modal');
    const closeModalBtn = document.getElementById('close-modal-btn');
    const modalCancelBtn = document.getElementById('modal-cancel-btn');

    const modalImg = document.getElementById('modal-img');
    const modalBadge = document.getElementById('modal-badge');
    const modalTitle = document.getElementById('modal-title');
    const modalPrice = document.getElementById('modal-price');
    const modalTime = document.getElementById('modal-time');
    const modalCalories = document.getElementById('modal-calories');
    const modalDesc = document.getElementById('modal-desc');
    const modalIngredients = document.getElementById('modal-ingredients');
    const modalPairing = document.getElementById('modal-pairing');

    const openModalBtns = document.querySelectorAll('.open-modal-btn');

    openModalBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        modalImg.src = btn.getAttribute('data-image');
        modalBadge.textContent = btn.getAttribute('data-badge') + ' • Nivel: ' + btn.getAttribute('data-level');
        modalTitle.textContent = btn.getAttribute('data-name');
        modalPrice.textContent = '$' + btn.getAttribute('data-price');
        modalTime.textContent = '⏱️ ' + btn.getAttribute('data-time') + ' de preparación';
        modalCalories.textContent = '🔥 ' + btn.getAttribute('data-calories');
        modalDesc.textContent = btn.getAttribute('data-desc');
        modalIngredients.textContent = btn.getAttribute('data-ingredients');
        modalPairing.textContent = btn.getAttribute('data-pairing');

        modal.classList.add('open');
        modal.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      });
    });

    function closeModal() {
      modal.classList.remove('open');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = 'auto';
    }

    closeModalBtn.addEventListener('click', closeModal);
    modalCancelBtn.addEventListener('click', closeModal);

    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        closeModal();
      }
    });

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.classList.contains('open')) {
        closeModal();
      }
    });
  </script>
</body>
</html>
